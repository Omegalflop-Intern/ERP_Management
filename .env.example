# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://admin:password123@mongodb:27017/mobile_shop_erp?authSource=admin
MONGODB_PORT=27017
MONGODB_DB=mobile_shop_erp
MONGODB_USER=admin
MONGODB_PASSWORD=password123

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:5000

# Server Port
SERVER_PORT=5000

# SMTP Configuration (for emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@erp.com

# Redis Configuration (optional)
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Nginx Ports
HTTP_PORT=80
HTTPS_PORT=443
