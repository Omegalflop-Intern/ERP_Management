# ─── API Base URL ──────────────────────────────────────────────
# Dev (Vite proxy): /api/v1
# Production (same domain): /api/v1
# Production (separate domain): https://api.yourdomain.com/api/v1
VITE_API_URL=/api/v1

# ─── Base Domain (for subdomain routing) ─────────────────────
VITE_BASE_DOMAIN=omegaflop.com

# ─── App Name ──────────────────────────────────────────────────
VITE_APP_NAME=Omegaflop Business Suite
