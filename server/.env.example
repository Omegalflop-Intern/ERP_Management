PORT=5000
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mobile_shop_erp

# JWT Authentication (CHANGE THIS IN PRODUCTION — min 32 chars!)
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d

# System Administrator
ADMIN_EMAIL=your@email.com
ADMIN_PHONE=+8801700000000

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_SENDER_NAME=Brothers Mobile
SMTP_SENDER_EMAIL=your@gmail.com

# SMS Gateway (BulkSMSBD — ৳0.45-0.48/SMS masking)
# Sign up at: https://bulksmsbd.net
SMS_API_URL=https://bulksmsbd.net/api/smsapi
SMS_API_KEY=your_sms_api_key_from_bulksmsbd
SMS_SENDER_ID=BrothersMob

# ─────────────────────────────────────────────────────────────
# PRODUCTION URLS — MUST be set or CORS, uploads & SMS links break
# APP_URL  = your backend server URL (e.g. https://api.yourdomain.com)
# CLIENT_URL = your frontend URL      (e.g. https://yourdomain.com)
# ALLOWED_ORIGIN = same as CLIENT_URL (used for CORS strict mode)
# ─────────────────────────────────────────────────────────────
APP_NAME=Brothers Mobile Shop ERP
APP_URL=https://api.yourdomain.com
CLIENT_URL=https://yourdomain.com
ALLOWED_ORIGIN=https://yourdomain.com
WEBSITE_URL=https://yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
