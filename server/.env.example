PORT=5000
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mobile_shop_erp

# JWT Authentication (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d

# System Administrator
ADMIN_EMAIL=your@email.com
ADMIN_PHONE=+8801700000000

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_SENDER_NAME=Brothers Mobile
SMTP_SENDER_EMAIL=your@gmail.com

# SMS Gateway
SMS_API_URL=https://api.greenweb.com.bd/api.php
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=BrothersMob

# Application URLs (your actual domain in production)
APP_NAME=Brothers Mobile Shop ERP
APP_URL=https://yourdomain.com
CLIENT_URL=https://yourdomain.com
ALLOWED_ORIGIN=https://yourdomain.com
