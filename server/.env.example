PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mobile_shop_erp

# JWT Authentication
JWT_SECRET=your_jwt_secret_min_10_chars
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d

# System Administrator Notifications
ADMIN_EMAIL=info.salahuddindev@gmail.com
ADMIN_PHONE=+8801700000000

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SENDER_NAME=Brothers Mobile
SMTP_SENDER_EMAIL=your_email@gmail.com

# Mobile SMS Gateway Configuration
SMS_API_URL=https://api.sms-provider.com/v1/send
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=BrothersMob

# Application URLs
APP_NAME=Brothers Mobile Shop ERP
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
