# ─── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/mobile_shop_erp
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/mobile_shop_erp
# Docker: mongodb://mongodb:27017/mobile_shop_erp
MONGODB_URI=mongodb://127.0.0.1:27017/mobile_shop_erp

# ─── JWT Authentication ───────────────────────────────────────
# Generate a strong random string (min 32 chars)
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Admin Notifications ──────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PHONE=

# ─── SMTP Email (Nodemailer) ──────────────────────────────────
# Gmail: smtp.gmail.com / 587 (use App Password, not real password)
# Outlook: smtp.office365.com / 587
# Custom: your SMTP host and port
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=
SMTP_SENDER_EMAIL=

# ─── SMS Gateway (sms.net.bd) ────────────────────────────────
SMS_API_URL=https://api.sms.net.bd/sendsms
SMS_API_KEY=
SMS_SENDER_ID=

# ─── Application URLs ────────────────────────────────────────
APP_NAME=Mobile Shop ERP
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Comma-separated allowed CORS origins (dev)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173

# ─── Production Only (optional) ──────────────────────────────
# Leave CLIENT_DIST_PATH empty for API-only mode (Nginx serves client)
# CLIENT_DIST_PATH=/home/user/client/dist

# TLS certs (only if using HTTPS directly on Node)
# TLS_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# ─── Seed Passwords (production only) ────────────────────────
# SEED_PASSWORD_ADMIN=YourStrongAdminPass123!
# SEED_PASSWORD_MANAGER=YourStrongManagerPass123!
# SEED_PASSWORD_CASHIER=YourStrongCashierPass123!
# SEED_PASSWORD_TECHNICIAN=YourStrongTechPass123!
# SEED_PASSWORD_SUPERADMIN=YourStrongSuperAdminPass123!
